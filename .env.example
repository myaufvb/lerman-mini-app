# Telegram Bot Settings
# Получите токен у @BotFather в Telegram
BOT_TOKEN=
# Ваш Telegram chat_id (узнать можно у @userinfobot или бот сам пришлет при /start)
ADMIN_CHAT_ID=

# Server & Mini App URL
PORT=5000
APP_URL=http://localhost:5173

# Ключ шифрования паролей (минимум 32 символа)
ENCRYPTION_KEY=lerman_super_secret_cipher_key_2026_secure!

# Интервал проверки доступности сайтов (в мс: 60000 = 1 минута)
UPTIME_INTERVAL_MS=60000
